# DATABASE/CORE
DATABASE_PATH=./data/app.db
PORT=3000
JWT_SECRET=your-signing-secret-string

# --- SSO (Single Sign-On) configuration BEGIN ---

# Enable SSO endpoints: set to "true" to activate, leave empty or "false" to disable.
# When disabled, only legacy login is available and SSO routes are inactive.
SSO_ENABLED=false

# Which OAuth SSO Provider to use (for now: "google")
# SSO_PROVIDER=google

# Google SSO client config (required if SSO_ENABLED=true & SSO_PROVIDER=google)
# SSO_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
# SSO_GOOGLE_CLIENT_SECRET=your-google-client-secret
# Must match your backend's exposed /api/v1/auth/sso/callback endpoint & registered provider callback URI:
# SSO_GOOGLE_CALLBACK_URL=http://localhost:3000/api/v1/auth/sso/callback

# Add additional providers as needed:
# SSO_<PROVIDER>_CLIENT_ID=
# SSO_<PROVIDER>_CLIENT_SECRET=
# SSO_<PROVIDER>_CALLBACK_URL=

# --- SSO (Single Sign-On) configuration END ---