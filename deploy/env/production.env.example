# Production Environment Configuration
# User Management Application – US-001 (Profile View & Edit)
#
# This file documents all environment variables required in production.
# Sensitive values MUST be stored in Kubernetes Secrets or a secrets manager
# (e.g. HashiCorp Vault, AWS Secrets Manager) — never committed to source control.

# ── Application ──────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=8080
APP_BASE_URL=https://user-management.example.com

# ── Database ─────────────────────────────────────────────────────────────────
# Source: Kubernetes Secret "user-management-secrets"
DB_HOST=<injected-from-secret>
DB_PORT=5432
DB_NAME=user_management
DB_USER=<injected-from-secret>
DB_PASSWORD=<injected-from-secret>
DB_SSL=true
DB_POOL_MIN=2
DB_POOL_MAX=10

# ── Email Service ─────────────────────────────────────────────────────────────
# Used for profile-update confirmation emails (US-001 requirement)
EMAIL_SERVICE_URL=https://email-service.internal/api/v1/send
EMAIL_FROM=no-reply@example.com
EMAIL_API_KEY=<injected-from-secret>

# ── Audit Logging ─────────────────────────────────────────────────────────────
# Captures timestamp, IP, and user-agent on every Name field change
AUDIT_LOG_ENABLED=true
AUDIT_LOG_DESTINATION=stdout   # or 'file' | 'remote'
AUDIT_LOG_LEVEL=info

# ── Security ──────────────────────────────────────────────────────────────────
# XSS sanitisation is applied server-side before persisting Name changes
XSS_SANITIZE_ENABLED=true
SESSION_SECRET=<injected-from-secret>
JWT_SECRET=<injected-from-secret>
CORS_ALLOWED_ORIGINS=https://user-management.example.com

# ── Performance ───────────────────────────────────────────────────────────────
# Profile page must load in < 2 seconds (spec requirement)
CACHE_TTL_SECONDS=60
COMPRESSION_ENABLED=true

# ── Health Checks ─────────────────────────────────────────────────────────────
# Kubernetes liveness / readiness probes hit these paths
HEALTH_LIVE_PATH=/health/live
HEALTH_READY_PATH=/health/ready
# Profile-feature smoke test endpoint (used by deploy script)
PROFILE_HEALTH_PATH=/api/v1/profile/health
