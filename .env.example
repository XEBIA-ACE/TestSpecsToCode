[tool.poetry]  # New: Introduces a modern dependency manifest using Poetry / PEP 517-compatible pyproject.toml
name = "flask-sqlalchemy-app"  # New: Project name placeholder for the monolith REST API application
version = "0.1.0"  # New: Initial project version for the upgraded stack
description = "Monolith REST API upgraded to Python 3.12, Flask 3.x, and SQLAlchemy 2.x"  # New: Describes the upgraded tech stack
authors = ["Your Name <you@example.com>"]  # New: Placeholder author metadata; adjust as needed
readme = "README.md"  # New: Points to project README for packaging metadata
license = "MIT"  # New: Placeholder license; update to your actual license
packages = [{ include = "app" }]  # New: Assumes application code is under the `app` package

[tool.poetry.dependencies]
python = "3.12.*"  # New: Sets the Python runtime baseline to 3.12 for compatibility with target stack
flask = "3.0.3"  # New: Pins Flask to 3.0.3 as required by the upgrade goal
sqlalchemy = "2.0.32"  # New: Pins SQLAlchemy to 2.0.32 per the upgrade target
python-dotenv = "^1.0.0"  # New: Enables loading environment variables from a .env file to externalize configuration
gunicorn = "^21.0.0"  # New: WSGI server dependency suitable for deploying the Flask 3.x app in production

[tool.poetry.group.dev.dependencies]
pytest = "^8.0.0"  # New: Introduces pytest as the primary test runner for modernized testing
pytest-cov = "^5.0.0"  # New: Adds coverage reporting to support better test coverage tracking
coverage = "^7.0.0"  # New: Provides coverage tooling for detailed analysis of test execution
ruff = "^0.5.0"  # New: Optional linter/formatter to help keep the codebase clean on the upgraded stack
mypy = "^1.10.0"  # New: Optional static type checker to leverage improved typing in Python 3.12 and libraries

[build-system]
requires = ["poetry-core>=1.8.0"]  # New: Defines the PEP 517 build backend required by Poetry
build-backend = "poetry.core.masonry.api"  # New: Specifies Poetry's build backend for packaging

[tool.pytest.ini_options]
minversion = "8.0"  # New: Ensures a recent pytest version compatible with Python 3.12
addopts = "-ra -q --strict-markers --strict-config --cov=app --cov-report=term-missing"  # New: Default pytest options with strictness and coverage enabled
testpaths = [  # New: Limits pytest discovery to standard test directories for the project
  "tests"
]

[tool.coverage.run]
source = ["app"]  # New: Restricts coverage measurement to the main application package
branch = true  # New: Enables branch coverage to better assess test thoroughness
omit = [  # New: Excludes non-essential modules from coverage calculations
  "tests/*"
]

[tool.coverage.report]
show_missing = true  # New: Shows which lines are missing coverage in reports
skip_covered = true  # New: Hides fully covered files to focus attention on gaps

[tool.ruff]
target-version = "py312"  # New: Aligns linting rules with Python 3.12 syntax and features
line-length = 100  # New: Sets a standard maximum line length for code style

[tool.mypy]
python_version = "3.12"  # New: Configures mypy to type-check assuming Python 3.12
ignore_missing_imports = true  # New: Allows gradual typing adoption without failing on missing stubs
strict_optional = true  # New: Enforces strict None handling to catch more bugs in the upgraded stack

[tool.app]  # New: Application-specific configuration section for the upgraded stack
env = "development"  # New: Default environment; should be overridden by APP_ENV in production
debug = true  # New: Enables Flask debug mode by default in development; must be false in production
secret_key_env = "FLASK_SECRET_KEY"  # New: Environment variable key from which Flask will read the secret key
log_level = "INFO"  # New: Default application log level for the upgraded runtime

[tool.app.flask]  # New: Flask-specific configuration for the 3.x app factory pattern
app_factory = "app:create_app"  # New: Dotted path to the Flask 3.x app factory used by WSGI/ASGI servers
preferred_url_scheme = "https"  # New: Indicates preferred URL scheme, relevant for externalized deployment settings

[tool.app.database]  # New: Centralized SQLAlchemy database configuration compatible with 2.x
uri_env = "DATABASE_URL"  # New: Environment variable that must contain the full SQLAlchemy 2.x-compliant DB URI
engine_echo = false  # New: Controls SQLAlchemy engine echo for debugging; can be toggled via env or overrides
future_engine_mode = true  # New: Ensures SQLAlchemy 2.x style engine and API usage
pool_pre_ping = true  # New: Enables connection health checks to improve reliability post-upgrade

[tool.app.testing]  # New: Test-related configuration integrated with pytest and Flask test client
use_pytest = true  # New: Signals that pytest is the primary test framework instead of raw unittest
enable_coverage = true  # New: Enables coverage integration during test runs for regression quality
database_uri_env = "TEST_DATABASE_URL"  # New: Environment variable that holds the test database URI for isolated testing

# Deprecated or replaced keys (commented out for clarity of the upgrade)
# [tool.app.deprecated_unittest]  # Deprecated: Placeholder for any legacy unittest-specific knobs (no longer used)
# enabled = false  # Deprecated: unittest is no longer the primary test driver; replaced by pytest configuration above