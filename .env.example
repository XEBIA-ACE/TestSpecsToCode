[flask]
# Flask application configuration for version 3.x
# Upgraded for compatibility with Flask 3.0.3

# The secret key for session management.
# Avoid hardcoding secrets in the config file for production; use environment variables if possible.
SECRET_KEY = ""

# The name of the module containing the Flask application.
# Set to your main module if needed.
FLASK_APP = "app"

# The environment: development, testing, or production.
ENV = "development"

# Enables or disables debug mode.
DEBUG = True

# Server name for subdomain support (optional).
# SERVER_NAME = "localhost:5000"

# The preferred URL scheme ('http' or 'https').
# This helps Flask build redirects with the right protocol.
PREFERRED_URL_SCHEME = "http"

# Maximum size of incoming request data (bytes).
# Introduced in Flask 2.3+. Prevents unwanted large requests.
# Set to a specific value to limit, or leave empty for unlimited (default).
MAX_CONTENT_LENGTH = 

# Enable or disable the usage of X-Sendfile header.
USE_X_SENDFILE = False

# Session cookie parameters, per Flask 3.x recommendations.
SESSION_COOKIE_NAME = "session"
SESSION_COOKIE_HTTPONLY = True
SESSION_COOKIE_SECURE = False  # Set True in production!
SESSION_COOKIE_SAMESITE = "Lax"

# Per Flask 3.x: SERVER_NAME value must match the host used by client applications.
# Uncomment and set if your app requires a server name.
# SERVER_NAME = "your.domain.com"

# Flask 2.x/3.x now loads .env or .flaskenv automatically for config overrides.
# No need to explicitly load them unless custom logic is in use.

# Deprecated in Flask 3.x; use 'SESSION_COOKIE_SAMESITE' instead of 'SESSION_COOKIE_DOMAIN' for modern cookie best practices.
# SESSION_COOKIE_DOMAIN =

# The template auto reload flag.
TEMPLATES_AUTO_RELOAD = True

# Per Flask 3.x release notes, JSONIFY_PRETTYPRINT_REGULAR is removed.
# Remove or comment out if present.
# JSONIFY_PRETTYPRINT_REGULAR =

# JSONIFY_MIMETYPE is also deprecated and should not be set.
# JSONIFY_MIMETYPE =

# Set to True to propagate exceptions, False to trap exceptions (dev use).
PROPAGATE_EXCEPTIONS = True

# Per Flask 3.x, 'EXPLAIN_TEMPLATE_LOADING' is still supported for template debugging.
EXPLAIN_TEMPLATE_LOADING = False

# Logging and error handling configuration
TRAP_HTTP_EXCEPTIONS = False
TRAP_BAD_REQUEST_ERRORS = False

[sqlalchemy]
# SQLAlchemy configuration for version 2.0.30
# Use environment-based URI in production for security
SQLALCHEMY_DATABASE_URI = ""
SQLALCHEMY_TRACK_MODIFICATIONS = False  # Flask-SQLAlchemy 3.x defaults to False, but keep explicitly for clarity

# The engine options key is unchanged, but you may tune pool sizes here.
SQLALCHEMY_ENGINE_OPTIONS = {}

# Deprecated in SQLAlchemy 2.x:
# SQLALCHEMY_BINDS = {...}  # Only add if your app requires multiple binds, else omit.

# Flask 3.x+ recommends using application factory pattern.
# If present, check for FLASK_RUN_FROM_CLI or related flags only if strictly necessary.

# All sensitive information (keys, URIs, credentials) should be loaded from environment variables,
# not hardcoded in this config file.