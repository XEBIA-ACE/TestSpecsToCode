[sqlalchemy]
# Database URL connection string
url = sqlite:///./test.db

# The 'implicit_returning' flag is now enabled by default in 2.0+
# implicit_returning = True

# The pool_pre_ping flag is supported and should remain for connection testing
pool_pre_ping = true

# Engine 'future' flag is removed in 2.0 as the future engine is now the default behavior
# future = true

# The 'echo' flag controls logging of SQL statements
echo = false

# In SQLAlchemy 2.0, the 'use_native_unicode' option is removed and always True for PostgreSQL dialects
# use_native_unicode is deprecated and has been removed; no longer configurable

# The 'poolclass' key can be used to specify a custom connection pool implementation (advanced use only)
# poolclass =

# 'max_overflow' and 'pool_size' still control connection pool sizing
pool_size = 5
max_overflow = 10

# The 'pool_timeout' key sets the time to wait for a connection from the pool
pool_timeout = 30

# The 'isolation_level' key can be set if you need a specific DB isolation, e.g., 'SERIALIZABLE'
# isolation_level =

# 'engine_options' are now passed directly as kwargs to create_engine
# engine_options = {}

# In SQLAlchemy 2.0, 'query_class' and 'session.query()' patterns are no longer configurable here and deprecated
# query_class is removed; session.query() API is replaced by modern Session method usage

# Additional pool recycle period in seconds (helps avoid stale connections)
pool_recycle = 3600