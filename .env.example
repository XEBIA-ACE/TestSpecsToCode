# Flask configuration template for Flask 3.0.3
# Updated for Flask 3.x compatibility and best practices
# All keys reflect the latest supported options as per Flask 3.0.3 documentation

# Secret key for session management and signing cookies.
SECRET_KEY = 'replace_this_with_a_random_secret_key'

# Debug mode. Should be False in production.
DEBUG = False

# Reload templates automatically. Defaults to None (flask will pick based on DEBUG).
TEMPLATES_AUTO_RELOAD = None

# Preferred URL scheme (e.g. 'http' or 'https').
PREFERRED_URL_SCHEME = 'http'

# Server name (if using subdomains).
SERVER_NAME = None

# Maximum allowed payload to be uploaded (in bytes). Default is 16 * 1024 * 1024 (16 MB).
MAX_CONTENT_LENGTH = 16 * 1024 * 1024

# Enable or disable propagation of exceptions.
PROPAGATE_EXCEPTIONS = None

# The session cookie name.
SESSION_COOKIE_NAME = 'session'

# The domain for the session cookie.
SESSION_COOKIE_DOMAIN = None

# The path for the session cookie.
SESSION_COOKIE_PATH = None

# "Lax" is Flask 3.0.3 default; can also be "Strict" or "None".
SESSION_COOKIE_SAMESITE = 'Lax'

# Secure flag for session cookie.
SESSION_COOKIE_SECURE = False

# HTTPOnly flag for session cookie.
SESSION_COOKIE_HTTPONLY = True

# Duration (in seconds) after which the permanent session expires.
PERMANENT_SESSION_LIFETIME = 2678400  # 31 days

# JSON sort keys is deprecated and will be removed in Flask 3.1,
# so it should not be used. Use JSON_SORT_KEYS only if you have a strong reason.
# JSON_SORT_KEYS = True

# JSON as_ascii is deprecated in Flask 3.x+
# JSON_AS_ASCII = False

# Use the new JSON provider (Flask 2.2+) - default is 'DefaultJSONProvider'.
JSON_PROVIDER_CLASS = 'flask.json.provider.DefaultJSONProvider'  # New in Flask 2.2+, default provider.

# If you're using trusted hosts, uncomment and set as needed.
# TRUSTED_HOSTS = ['example.com']

# Deprecation note: FLASK_ENV is removed in Flask 3.0 — use environment variables to select environment.

# Other custom config values can be added below.