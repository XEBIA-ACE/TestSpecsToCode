[sqlalchemy]
# SQLAlchemy database URL, should be set securely (never hardcode credentials)
# Example: postgresql+psycopg2://user:password@host:port/dbname
database_url = ${DATABASE_URL}

# The SQLAlchemy engine echo flag: enables SQL query logging if set to True
# (Recommended: use environment variable or debugging toggle in production)
echo = False

# SQLAlchemy 2.x: Enable new-style execution mode
# This enforces SQLAlchemy 2.0 API behaviors, disables legacy behavior
engine_strategy = "threadlocal"  # Default value; not changed in 2.x
future = True  # New in 1.4/2.x: enable 2.x API mode for full forward-compatibility

# SQLAlchemy 2.x: Isolation level setting – now must be set explicitly if needed
# isolation_level = "READ COMMITTED"  # Uncomment and set as needed

# Pool settings
pool_size = 5         # Default connection pool size
max_overflow = 10     # Default maximum overflow for connection pool

# (DEPRECATED) 'use_native_unicode' was removed in SQLAlchemy 2.x
# use_native_unicode = True

# (DEPRECATED in 2.x) 'convert_unicode' replaced by native Unicode support
# convert_unicode = True

# (DEPRECATED in 2.x) 'encoding' is now handled automatically
# encoding = utf-8

# Session configuration
autocommit = False   # (Still supported; ensure not used in code, forced True is deprecated)
autoflush = True

# SQLAlchemy 2.x: Enable new connection execution options if needed
# execution_options = {"isolation_level": "READ COMMITTED"}

[flask]
# Flask secret key, should ALWAYS be set via environment variable
secret_key = ${FLASK_SECRET_KEY}

# Flask 3.x compatibility: Enable JSON sorting (if required)
json_sort_keys = False

# Flask 3.x compatibility: Set session cookie security flags
session_cookie_secure = True
session_cookie_httponly = True
session_cookie_samesite = "Lax"

# (DEPRECATED) Flask 1.x JSONIFY_PRETTYPRINT_REGULAR removed in Flask 3.x
# jsonify_prettyprint_regular = False

[app]
# Application-specific runtime settings can be added here
debug = False

[python]
# Minimum Python version required for SQLAlchemy 2.x and Flask 3.x
version = 3.12

# End of configuration