[sqlalchemy]
# Explicitly specifying SQLAlchemy version for compatibility
version = 2.0.29

# The database URL should be provided via environment variable for security
# Example: postgresql+psycopg2://username:password@host:port/dbname
url = ${DATABASE_URL}

# Set echo to false by default; can be controlled via environment variable if needed
echo = false

# Future mode is now always enabled in SQLAlchemy 2.x (no need for 'future' flag)
# future = true

# Use the 2.0 style engine and session configuration
# The 'engine_options' section is recommended for SQLAlchemy 2.x
[engine_options]
# Enable pool pre-ping to mitigate stale connections (recommended in 2.x)
pool_pre_ping = true  # New in 2.x: actively verifies connections from the pool

# Explicitly use NullPool if a connection pool is not desired
# poolclass = sqlalchemy.pool.NullPool

# ORM Configuration
[orm]
# Use sessionmaker with explicit engine binding, as implicit binds are deprecated
# Note: Session-related parameters should be tuned as needed
autocommit = false   # Deprecated in 2.x, so setting for backward compatibility only (has no effect)
autoflush = true     # Explicitly set autoflush behavior

# Enforce new ORM patterns: no longer support scoped_session as default
#scoped_session = true  # Deprecated/replaced: use context-managed session patterns

[migrations]
# Place holder for migration tool config (e.g. Alembic), if used
# Add migration configuration here if required by your CI/CD pipeline
enabled = false  # Set to true and configure if Alembic or other migration tool is present

# Additional recommended configurations for SQLAlchemy 2.x should be placed here

# Deprecated/removed keys for SQLAlchemy 2.x:
# [database]
# uri = ...
# bind = ...
# These keys have been replaced by the 'url' setting above.