{
  "compilerOptions": {
    "target": "ES2022",                          // Set ECMAScript target to match Node.js 22/24 compatibility and TypeScript 5.4 defaults
    "module": "NodeNext",                        // Use NodeNext module system for latest Node.js compatibility
    "moduleResolution": "NodeNext",              // Improved Node.js 22+ ESM/CJS interop support
    "lib": ["ES2022"],                           // Match lib to target Node.js/TypeScript runtime
    "declaration": true,                         // Generate .d.ts files for package consumers
    "outDir": "./dist",                          // Output directory for compiled files
    "rootDir": "./src",                          // Root code directory for source files
    "esModuleInterop": true,                     // Allow default imports from modules with only CommonJS exports
    "forceConsistentCasingInFileNames": true,    // Enforce consistent file name casing
    "strict": true,                              // Enable all strict type checking options
    "skipLibCheck": true,                        // Skip type checking of all declaration files
    "allowSyntheticDefaultImports": true,        // Allow default imports from modules without default export
    "resolveJsonModule": true,                   // Allow importing .json files
    "noImplicitOverride": true,                  // New in TypeScript 5.x: require explicit override keyword
    "useUnknownInCatchVariables": true,          // Newer TS setting: use 'unknown' instead of 'any' in catch clauses
    "verbatimModuleSyntax": true                 // Enforce ECMAScript import/export syntax (TypeScript 5.4+ best practice)
  },
  "include": [
    "src/**/*"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "**/*.test.ts",
    "**/__tests__/**"
  ]
}