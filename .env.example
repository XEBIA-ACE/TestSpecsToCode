[Requires-Python]
# Minimum required Python version is now 3.12 due to runtime upgrade
python_requires = ">=3.12"

[build-system]
# Ensures build tools run under Python 3.12 environment
requires = ["setuptools>=61.0", "wheel"]
build-backend = "setuptools.build_meta"

[project]
# Required metadata fields
name = "your-application"
version = "1.0.0"
description = "Monolithic REST API upgraded to Python 3.12"
authors = [
    { name="Your Name", email="your@email.com" }
]
readme = "README.md"
# Specify supported Python version for distribution
requires-python = ">=3.12"

dependencies = [
    # Upgraded Flask to 3.0.3 for Python 3.12 compatibility
    "Flask==3.0.3",             # Flask updated to 3.0.3 (required for Python 3.12)
    "SQLAlchemy==2.0.30",       # SQLAlchemy updated to 2.0.30 (required for Python 3.12)
    # Add other runtime dependencies as needed
]

[tool.setuptools]
package-dir = {"" = "src"}

#[tool.poetry] 
# If using poetry, ensure python="^3.12" in tool.poetry.dependencies
# poetry is UNASSUMED unless present in original config

# Note: If hardcoded credentials were present, remove them and externalize via environment/config. No credential keys included by default.

# Note: If containerization config is added later, use Dockerfile with FROM python:3.12-bullseye. Not included here, as this config is Python project-focused.